DATABASE_URL=postgresql+psycopg2://scout:scout@localhost:5432/scout
# dev แบบไม่มี Postgres: DATABASE_URL=sqlite:///./scout.db
REDIS_URL=redis://localhost:6379/0
CORS_ORIGINS=http://localhost:3000

# อัตราแลกเปลี่ยนเป็นบาทไทย
USD_THB_RATE=36.50
CNY_THB_RATE=5.10

# ร้านค้า / การรับชำระเงิน
SHOP_NAME=ร้านป้าศรี
PROMPTPAY_TARGET=0987263206
PAYMENT_WINDOW_MINUTES=15
# ความลับของ webhook แจ้งเงินเข้าจาก Zapier (ส่งมาใน header X-Webhook-Secret)
BANK_WEBHOOK_SECRET=
# โทเคนสำหรับ /admin (ส่งมาใน header X-Admin-Token) — production ต้องตั้ง
ADMIN_TOKEN=

# ขนส่ง: manual = แอดมินกรอกเลขพัสดุเอง
FULFILLMENT_PROVIDER=manual
