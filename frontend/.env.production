# หน้าเว็บอยู่ Cloudflare Pages · API อยู่ Render — คนละโดเมนแล้ว ต้องใส่ URL เต็ม
# ค่านี้ถูกฝังตอน build (static export) เปลี่ยนแล้วต้อง build ใหม่
# ถ้าชื่อ service บน Render ไม่ใช่ scout-api ให้ override ด้วย environment variable
# ชื่อเดียวกันใน Cloudflare Pages → Settings → Environment variables
NEXT_PUBLIC_API_URL=https://scout-api.onrender.com
