# หน้าเว็บอยู่ Cloudflare Pages · API อยู่ Render — คนละโดเมนแล้ว ต้องใส่ URL เต็ม
# ค่านี้ถูกฝังตอน build (static export) เปลี่ยนแล้วต้อง build ใหม่
# ถ้าย้าย backend ไปที่อื่น แก้ที่บรรทัดล่างนี้ หรือ override ด้วย environment variable
# ชื่อเดียวกันใน Cloudflare → Settings → Variables
NEXT_PUBLIC_API_URL=https://scout-api-ncqo.onrender.com
